const PM_SHEET_ID='CONFIGURE_PRIVATE_LIVE_SHEET_ID';
const PM_MODE='live';
const PM_PUBLIC_URL='https://ustppu.github.io/main/';
const PM_OWNER='ppd-b110-cm4@moe-dl.edu.my';
const PM_ADMINS=[PM_OWNER,'g-49369646@moe-dl.edu.my','g-40519518@moe-dl.edu.my'];
const PM_TABLES={programs:'PM_Programs',registrations:'PM_Registrations',attendance:'PM_Attendance',feedback:'PM_Feedback',certificates:'PM_Certificates',operations:'PM_Operations',audit:'PM_Audit'};
function pmBook_(){const book=SpreadsheetApp.openById(PM_SHEET_ID);if(!book||book.getId()!==PM_SHEET_ID)throw Error('Projek belum dipadankan dengan Sheet Programme Manager staging.');return book;}
function pmHash_(s){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(s),Utilities.Charset.UTF_8).map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join('');}
function pmIdentity_(){return String(Session.getActiveUser().getEmail()||'').toLowerCase().trim();}
function pmStore_(){
 const book=pmBook_(),sheets={},rowCache={};
 const sheet=name=>{if(!PM_TABLES[name])throw Error('Tab tidak dibenarkan.');const s=sheets[name]||(sheets[name]=book.getSheetByName(PM_TABLES[name]));if(!s)throw Error('Programme Manager belum disediakan.');return s;};
 const rows=name=>{if(rowCache[name])return rowCache[name];const s=sheet(name),n=s.getLastRow();if(n>5000)throw Error('Had staging dicapai. Arkib dan kapasiti perlu disemak.');return rowCache[name]=n<2?[]:s.getRange(2,1,n-1,3).getValues();};
 return {list:name=>rows(name).filter(r=>r[0]).map(r=>JSON.parse(r[1])),get:(name,id)=>{const row=rows(name).find(r=>r[0]===id);return row?JSON.parse(row[1]):null;},put:(name,id,data)=>{if(typeof id!=='string'||!/^[A-Za-z0-9_-]{5,100}$/.test(id))throw Error('ID rekod tidak sah.');const raw=JSON.stringify(data);if(raw.length>45000)throw Error('Rekod terlalu besar.');const s=sheet(name),all=rows(name),i=all.findIndex(r=>r[0]===id),row=i<0?s.getLastRow()+1:i+2;const updated=[id,raw,new Date().toISOString()];s.getRange(row,1,1,3).setValues([updated]);if(i<0)all.push(updated);else all[i]=updated;SpreadsheetApp.flush();},lock:fn=>{const lock=LockService.getScriptLock();lock.waitLock(30000);try{return fn();}finally{lock.releaseLock();}}};
}
function pmPinConfig_(){try{const c=JSON.parse(PropertiesService.getScriptProperties().getProperty('PM_ADMIN_PIN_V1')||'null');return c&&/^[a-f0-9]{64}$/.test(c.salt)&&/^[a-f0-9]{64}$/.test(c.hash)?c:null;}catch{return null;}}
function pmSession_(token){const raw=CacheService.getScriptCache().get('PM_SESSION:'+pmHash_(String(token||'')));if(!raw)throw Error('Sesi tamat. Masuk semula sebagai admin.');const session=JSON.parse(raw);if(!PM_ADMINS.includes(session.actor)||(pmPinConfig_()?session.auth!=='pin-v1':pmIdentity_()!==session.actor))throw Error('Sila masuk semula menggunakan kaedah log masuk semasa.');return session;}
function pmPinLogin_(payload,config){
 const actor=String(payload&&payload.email||'').trim().toLowerCase(),pin=typeof(payload&&payload.pin)==='string'?payload.pin:'';
 if(!config)return {ok:false,code:'AUTH_CONFIG',message:'Log masuk admin belum tersedia. Hubungi pengurus sistem.'};
 const lock=LockService.getScriptLock();lock.waitLock(10000);try{
  const props=PropertiesService.getScriptProperties(),bucket='PM_AUTH_TRIES:'+pmHash_(PM_ADMINS.includes(actor)?actor:'unknown'),time=Date.now();let state;try{state=JSON.parse(props.getProperty(bucket)||'null');}catch{}if(!state||time>=state.until)state={count:0,until:time+300000};
  if(state.count>=5)return {ok:false,code:'RATE_LIMIT',message:'Terlalu banyak cubaan gagal. Cuba semula selepas 5 minit.'};
  const candidate=pmHash_(config.salt+'|'+(pin.length<=128?pin:''));let diff=candidate.length^config.hash.length;for(let i=0;i<config.hash.length;i++)diff|=candidate.charCodeAt(i)^config.hash.charCodeAt(i);
  if(!PM_ADMINS.includes(actor)||!pin||pin.length>128||diff!==0){state.count++;props.setProperty(bucket,JSON.stringify(state));return {ok:false,code:'FORBIDDEN',message:'Emel admin atau PIN tidak betul.'};}
  props.deleteProperty(bucket);const token=Utilities.getUuid()+Utilities.getUuid();CacheService.getScriptCache().put('PM_SESSION:'+pmHash_(token),JSON.stringify({actor,role:'admin',auth:'pin-v1'}),3600);return {ok:true,data:{token,actor}};
 }finally{lock.releaseLock();}
}
function pmApi(request){
 try{pmBook_();if(!request||typeof request.action!=='string')throw Error('Permintaan tidak sah.');if(request.action==='public.config')return {ok:true,data:{publicUrl:PM_PUBLIC_URL,mode:PM_MODE,adminLoginMode:pmPinConfig_()?'pin':'google',adminUrl:'https://script.google.com/macros/s/AKfycbwKSqs9GlN8dm39xJMaOPzmtWU6ZFEBSfZeK0dYjeO0fLvLBB7TDayMPuSHaegoo8HVvg/exec'}};if(request.action==='admin.login'){const config=pmPinConfig_();if(config)return pmPinLogin_(request.payload||{},config);const actor=pmIdentity_();if(!PM_ADMINS.includes(actor))return {ok:false,code:'FORBIDDEN',message:'Gunakan akaun admin MOE yang dibenarkan sehingga PIN diaktifkan oleh pemilik.'};const token=Utilities.getUuid()+Utilities.getUuid();CacheService.getScriptCache().put('PM_SESSION:'+pmHash_(token),JSON.stringify({actor,role:'admin',auth:'google-v1'}),3600);return {ok:true,data:{token,actor}};}if(request.action==='admin.logout'){pmSession_(request.token);CacheService.getScriptCache().remove('PM_SESSION:'+pmHash_(String(request.token||'')));return {ok:true,data:{signedOut:true}};}
  const ctx=request.action.startsWith('admin.')?pmSession_(request.token):{role:'public'};ctx.requestId=request.requestId;
  const service=PKGDomain.createService({store:pmStore_(),hash:pmHash_,secret:()=>Utilities.getUuid()+Utilities.getUuid(),id:()=>Utilities.getUuid().replace(/-/g,'').slice(0,14).toUpperCase(),now:()=>new Date().toISOString()});
  return {ok:true,data:service.call(request.action,request.payload||{},ctx)};
 }catch(error){return {ok:false,code:error.code||'SERVER',message:error.message||'Permintaan gagal. Cuba semula dengan ID permintaan yang sama.'};}
}
function configureProgrammeAdminPin(payload){
 if(pmIdentity_()!==PM_OWNER)throw Error('Tetapan PIN hanya boleh dibuat oleh pemilik cm4 melalui akaun Google sebenar.');
 const pin=payload&&payload.pin,confirmation=payload&&payload.confirmation;if(typeof pin!=='string'||pin.length<8||pin.length>128||pin!==confirmation)throw Error('Masukkan PIN yang sama dalam kedua-dua ruangan, sekurang-kurangnya 8 aksara.');
 const lock=LockService.getScriptLock();lock.waitLock(10000);try{const salt=pmHash_(Utilities.getUuid()+Utilities.getUuid());PropertiesService.getScriptProperties().setProperty('PM_ADMIN_PIN_V1',JSON.stringify({salt,hash:pmHash_(salt+'|'+pin)}));return {saved:true};}finally{lock.releaseLock();}
}
function pmPinSetupPage_(){if(pmIdentity_()!==PM_OWNER)return HtmlService.createHtmlOutput('<h1>Akses ditolak</h1><p>Gunakan akaun pemilik cm4.</p>');return HtmlService.createHtmlOutput(`<!doctype html><html lang="ms"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Aktifkan PIN admin USTP</title><style>body{font:16px Arial;background:#f2f6f5;color:#17363b;padding:24px}main{max-width:480px;margin:30px auto;background:white;padding:28px;border-radius:18px}label,input,button{display:block}input{box-sizing:border-box;width:100%;padding:12px;margin:8px 0 20px;border:1px solid #aabeb7;border-radius:8px;font-size:18px}button{padding:14px;border:0;border-radius:8px;background:#126b60;color:white;font-size:16px}#status{margin-top:20px}small{display:block;line-height:1.6}</style></head><body><main><h1>Aktifkan PIN admin</h1><p>USTP PPD Petaling Utama</p><p>Selepas disimpan, Programme Manager menggunakan emel admin dan PIN sahaja. Log masuk Google tidak lagi diperlukan pada pautan Hub.</p><form id="setup"><label for="pin">PIN baharu</label><input id="pin" type="password" required minlength="8" maxlength="128" autocomplete="new-password"><label for="confirmation">Sahkan PIN</label><input id="confirmation" type="password" required minlength="8" maxlength="128" autocomplete="new-password"><button id="save">Simpan &amp; aktifkan PIN</button></form><div id="status" role="status"></div><small>Hanya tiga emel admin yang dibenarkan. Lima cubaan gagal menyekat cubaan akaun tersebut selama lima minit. Tetapan ini tidak mengubah data peserta.</small><p><a href="https://ustppu.github.io/main/#/admin" target="_top">Buka Programme Manager</a></p></main><script>document.getElementById('setup').addEventListener('submit',function(e){e.preventDefault();const pin=document.getElementById('pin'),confirmation=document.getElementById('confirmation'),status=document.getElementById('status'),save=document.getElementById('save');if(pin.value!==confirmation.value){status.textContent='PIN tidak sama. Semak kedua-dua ruangan.';return;}save.disabled=true;google.script.run.withSuccessHandler(function(){document.getElementById('setup').reset();document.getElementById('setup').hidden=true;status.textContent='PIN sudah aktif. Buka semula Programme Manager melalui Hub dan masuk menggunakan emel admin serta PIN.';}).withFailureHandler(function(e){save.disabled=false;status.textContent=e.message;}).configureProgrammeAdminPin({pin:pin.value,confirmation:confirmation.value});});</script></body></html>`).setTitle('Aktifkan PIN admin USTP');}
function doGet(e){if(e&&e.parameter&&e.parameter.setupAdminPin==='1')return pmPinSetupPage_();if(e&&e.parameter&&e.parameter.public==='catalog'){const callback=String(e.parameter.callback||'');if(!/^USTP_PUBLIC_[a-f0-9]{32}$/.test(callback))return ContentService.createTextOutput('Invalid callback').setMimeType(ContentService.MimeType.TEXT);const result=pmApi({action:'public.catalog'});return ContentService.createTextOutput(callback+'('+JSON.stringify(result).replace(/</g,'\\u003c')+');').setMimeType(ContentService.MimeType.JAVASCRIPT);}return HtmlService.createHtmlOutputFromFile('Index').setTitle('USTP PPD Petaling Utama').addMetaTag('viewport','width=device-width, initial-scale=1');}
function setupProgrammeStaging(){
 if(pmIdentity_()!==PM_OWNER)throw Error('Persediaan hanya oleh cm4.');if(PM_MODE!=='staging')throw Error('Persediaan rekaan dinyahaktifkan pada live.');const book=pmBook_();
 for(const name of Object.values(PM_TABLES)){let s=book.getSheetByName(name);if(!s){s=book.insertSheet(name);s.getRange(1,1,1,3).setValues([['ID','JSON','UpdatedAt']]);s.setFrozenRows(1);s.setColumnWidths(1,1,190);s.setColumnWidths(2,1,500);}if(!s.getProtections(SpreadsheetApp.ProtectionType.SHEET).length){const protection=s.protect().setDescription('Programme Manager - tulis melalui server');const editors=protection.getEditors().filter(u=>u.getEmail()!==PM_OWNER);if(editors.length)protection.removeEditors(editors);if(protection.canDomainEdit())protection.setDomainEdit(false);}}
 const guide=book.getSheetByName('Sheet1');if(guide&&guide.getLastRow()===0){guide.setName('MULA_DI_SINI');guide.getRange(1,1,4,1).setValues([['PKG Programme Manager — DATA REKAAN STAGING'],['Pemilik: '+PM_OWNER],['Rekod operasi ditulis melalui aplikasi server sahaja.'],['Tiada emel atau trigger dipasang.']]);const protect=guide.protect().setDescription('Panduan staging private');const editors=protect.getEditors().filter(u=>u.getEmail()!==PM_OWNER);if(editors.length)protect.removeEditors(editors);if(protect.canDomainEdit())protect.setDomainEdit(false);}
 const store=pmStore_();if(!store.list('programs').length){for(const p of PKGFixtures().programs)store.put('programs',p.id,{...p,eventKey:Utilities.getUuid()+Utilities.getUuid()});}
 Logger.log(JSON.stringify({ready:true,sheet:book.getId(),tables:Object.values(PM_TABLES),data:'Rekaan staging',sheetsProtected:true,mail:'No email scope or delivery',triggers:'None installed'}));
}
function programmeStagingCheck(){
 if(pmIdentity_()!==PM_OWNER)throw Error('Semakan hanya oleh cm4.');if(PM_MODE!=='staging')throw Error('Ujian rekaan dinyahaktifkan pada live.');setupProgrammeStaging();
 const login=pmApi({action:'admin.login'});if(!login.ok)throw Error(login.message);const token=login.data.token,access=pmApi({action:'admin.eventAccess',token,requestId:'google-pm-check-access-20261104',payload:{id:'PG-STUDIO'}});if(!access.ok)throw Error(access.message);
 const requestId='google-pm-check-register-20261104',registration=pmApi({action:'public.register',requestId,payload:{programId:'PG-STUDIO',name:'Peserta Ujian Google',email:'qa-google@example.invalid',school:'Sekolah Ujian',consent:true,eventKey:access.data.eventKey}});if(!registration.ok)throw Error(registration.message);
 const r=registration.data;
 const attend=pmApi({action:'admin.attend',token,requestId:'google-pm-check-attend-20261104',payload:{programId:'PG-STUDIO',registrationId:r.registrationId,accessKey:r.accessKey,method:'qr'}});if(!attend.ok)throw Error(attend.message);
 const publish=pmApi({action:'admin.publishCertificates',token,requestId:'google-pm-check-publish-20261104',payload:{id:'PG-STUDIO'}});if(!publish.ok)throw Error(publish.message);
 const feedback=pmApi({action:'public.feedback',requestId:'google-pm-check-feedback-20261104',payload:{registrationId:r.registrationId,accessKey:r.accessKey,rating:5,comment:'Maklum balas rekaan.',suggestion:''}});if(!feedback.ok)throw Error(feedback.message);
 const certificate=pmApi({action:'public.certificate',requestId:'google-pm-check-certificate-20261104',payload:{registrationId:r.registrationId,accessKey:r.accessKey}});if(!certificate.ok)throw Error(certificate.message);
 const verify=pmApi({action:'public.verify',payload:{id:certificate.data.certificate.id}});if(!verify.ok||verify.data.status!=='valid')throw Error('Verification failed');
 Logger.log(JSON.stringify({result:'PASS',registration:r.registrationId,attendance:true,feedback:true,certificate:certificate.data.certificate.id,verify:true,sourceModulesUnchanged:true,mailSent:false}));
}

function initializeUstpLive(){
 if(pmIdentity_()!==PM_OWNER)throw Error('Persediaan hanya oleh cm4.');if(PM_MODE!=='live')throw Error('Konfigurasi bukan live.');const book=pmBook_();
 for(const name of Object.values(PM_TABLES)){let sheet=book.getSheetByName(name);if(!sheet){sheet=book.insertSheet(name);sheet.getRange(1,1,1,3).setValues([['ID','JSON','UpdatedAt']]);sheet.setFrozenRows(1);sheet.setColumnWidths(1,1,190);sheet.setColumnWidths(2,1,500);}else{const header=sheet.getRange(1,1,1,3).getValues()[0];if(header.join('|')!=='ID|JSON|UpdatedAt')throw Error('Header tidak sepadan: '+name);}if(!sheet.getProtections(SpreadsheetApp.ProtectionType.SHEET).length){const protection=sheet.protect().setDescription('USTP — tulis melalui server');const editors=protection.getEditors().filter(u=>u.getEmail()!==PM_OWNER);if(editors.length)protection.removeEditors(editors);if(protection.canDomainEdit())protection.setDomainEdit(false);}}
 const guide=book.getSheetByName('Sheet1');if(guide&&guide.getLastRow()===0){guide.setName('PANDUAN_DATA_KEKAL');guide.getRange(1,1,5,1).setValues([['USTP PPD Petaling Utama — DATA KEKAL'],['Pendaftaran sebenar. Jangan padam atau gantikan dengan data rekaan.'],['Kemaskini kod tidak memadam rekod peserta.'],['Pemilik: '+PM_OWNER],['Repo utama: https://github.com/ustpPU/main']]);const p=guide.protect().setDescription('Panduan database kekal');const editors=p.getEditors().filter(u=>u.getEmail()!==PM_OWNER);if(editors.length)p.removeEditors(editors);if(p.canDomainEdit())p.setDomainEdit(false);}
 const store=pmStore_();store.lock(()=>{if(!store.get('programs','PG-STEMAI-20261104'))store.put('programs','PG-STEMAI-20261104',{id:'PG-STEMAI-20261104',title:'Bengkel Transformasi Digital STEM: Pemerkasaan Literasi AI',date:'2026-11-04',start:'08:30',end:'16:00',registrationCloses:'2026-11-04',category:'Bengkel',venue:'MAHSA Avenue International College',organizer:'USTP PPD Petaling Utama',description:'Bengkel Transformasi Digital STEM: Pemerkasaan Literasi AI.\n\nPeserta: Pengetua dan Guru Besar daripada semua sekolah rendah (SR) dan sekolah menengah (SM).\n\nImbas QR acara, lengkapkan nama penuh, emel dan sekolah. Pendaftaran terus direkodkan sebagai kehadiran.',capacity:5000,status:'published',eventMode:'onsite',checkInOpen:true,eventKey:Utilities.getUuid()+Utilities.getUuid(),feedbackRequired:true,certificatesPublished:false,accent:'teal',createdAt:new Date().toISOString(),updatedAt:new Date().toISOString()});});
 Logger.log(JSON.stringify({ready:true,mode:PM_MODE,programId:'PG-STEMAI-20261104',registered:store.list('registrations').length,attended:store.list('attendance').length,existingDataPreserved:true,sheetsProtected:true,mail:'None',triggers:'None'}));
}
function verifyUstpLive(){if(pmIdentity_()!==PM_OWNER)throw Error('Semakan hanya oleh cm4.');const store=pmStore_(),p=store.get('programs','PG-STEMAI-20261104');if(!p||p.title!=='Bengkel Transformasi Digital STEM: Pemerkasaan Literasi AI'||p.date!=='2026-11-04'||p.eventMode!=='onsite')throw Error('Semak tetapan acara.');Logger.log(JSON.stringify({verified:true,programId:p.id,date:p.date,start:p.start,end:p.end,mode:p.eventMode,registered:store.list('registrations').length,attended:store.list('attendance').length,noResetPerformed:true}));}
